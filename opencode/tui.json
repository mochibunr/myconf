{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin-beautiful",
  "diff_style": "auto",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4
  }
}
